{
  "name": "genesis-observer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5173 --strictPort",
    "test": "vitest run",
    "format": "prettier --write src vite.config.ts index.html",
    "format:check": "prettier --check src vite.config.ts index.html"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^5.1.0"
  }
}
